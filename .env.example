# Question Bank Lite MVP-0 v3
# The app starts locally even when GCP values are blank.

# Local storage
QB_DATA_DIR=./data
QB_MAX_PAGES=200

# Vertex AI Gemini. Leave GCP_PROJECT_ID blank for local-only mode.
QB_PDF_LLM=vertex
QB_VERIFY=on
GCP_PROJECT_ID=
GCP_REGION=asia-south1
VERTEX_MODEL_PRIMARY=gemini-3.5-flash
VERTEX_MODEL_VERIFY=gemini-3.5-flash

# Process large PDFs as small overlapping Gemini batches.
QB_GEMINI_CHUNK_PAGES=8
QB_GEMINI_CHUNK_OVERLAP=1
QB_GEMINI_MAX_OUTPUT_TOKENS=24000

# Document AI Enterprise OCR + Math OCR.
# Create one Enterprise Document OCR processor and paste its ID.
DOCUMENTAI_LOCATION=us
DOCUMENTAI_PROCESSOR_ID=
DOCUMENTAI_CHUNK_PAGES=15

# Formula correction tool: documentai | auto | mathpix | pix2tex
QB_OCR=auto

# Google OpenID Connect and application sessions
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_SESSION_SECRET=
APP_BASE_URL=http://127.0.0.1:8000
ADMIN_EMAILS=
# Mock login is available only when both values are explicitly set.
# APP_ENV=development
# AUTH_MODE=mock

# Optional fallbacks. Not required for the GCP-native path.
# MATHPIX_APP_ID=
# MATHPIX_APP_KEY=
# GCP_VISION_API_KEY=
ADMIN_LOCAL_EMAIL=
ADMIN_LOCAL_PASSWORD=
