# Question Bank Cloud MVP-0 v4
# The app starts locally even when GCP values are blank.

# Local storage
QB_DATA_DIR=./data
QB_MAX_PAGES=200

# Vertex AI Gemini. Leave GCP_PROJECT_ID blank for local-only mode.
QB_PDF_LLM=vertex
QB_VERIFY=on
GCP_PROJECT_ID=
GCP_REGION=asia-south1
VERTEX_MODEL_PRIMARY=gemini-2.5-flash
VERTEX_MODEL_VERIFY=gemini-2.5-flash
VERTEX_MODEL_TUTOR=gemini-2.5-flash
AI_MAX_RETRIES=1
AI_GENERATION_MAX_OUTPUT_TOKENS=12000
AI_GUIDANCE_MAX_OUTPUT_TOKENS=4096
BLUEPRINT_MAX_OUTPUT_TOKENS=5000
BLUEPRINT_MAX_RETRIES=1
TUTOR_MAX_OUTPUT_TOKENS=900

# Process large PDFs as small overlapping Gemini batches.
QB_GEMINI_CHUNK_PAGES=8
QB_GEMINI_CHUNK_OVERLAP=1
QB_GEMINI_MAX_OUTPUT_TOKENS=12000

# Document AI Enterprise OCR + Math OCR.
# Create one Enterprise Document OCR processor and paste its ID.
DOCUMENTAI_LOCATION=us
DOCUMENTAI_PROCESSOR_ID=
DOCUMENTAI_CHUNK_PAGES=15

# Formula correction tool: documentai | auto | mathpix | pix2tex
QB_OCR=auto

# Google OpenID Connect and application sessions
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_SESSION_SECRET=
APP_BASE_URL=http://127.0.0.1:8000
ADMIN_EMAILS=
# For local mock login, set ADMIN_EMAILS=admin@meritiqra.com (or another test admin email).
# Mock login is available only when both values are explicitly set.
# APP_ENV=development
# AUTH_MODE=mock

# Optional fallbacks. Not required for the GCP-native path.
# MATHPIX_APP_ID=
# MATHPIX_APP_KEY=
# GCP_VISION_API_KEY=
ADMIN_LOCAL_EMAIL=
ADMIN_LOCAL_PASSWORD=
# Development convenience only: run_local_gcp.sh defaults to admin@meritiqra.com / meritiqra-local-admin.

# Cloud v4 persistence. Leave DATABASE_URL blank for local SQLite development.
DATABASE_URL=
DATABASE_BACKEND=sqlite
STORAGE_BACKEND=local
GCS_DATA_BUCKET=
# Cloud Run uses /mnt/qb-data, backed by a private Cloud Storage volume.
# QB_DATA_DIR=/mnt/qb-data

# Commerce. Keep fake providers in local development; never commit live secrets.
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OTP/contact encryption and scheduled worker authentication.
OTP_PEPPER=
CONTACT_ENCRYPTION_KEY=
OTP_EXPOSE_TEST_CODE=0
INTERNAL_JOB_TOKEN=

# Transactional email: fake | smtp
EMAIL_PROVIDER=fake
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# DLT-capable SMS HTTP adapter: fake | http
SMS_PROVIDER=fake
SMS_API_URL=
SMS_API_KEY=
SMS_PE_ID=
SMS_SENDER_ID=
SMS_OTP_TEMPLATE_ID=
